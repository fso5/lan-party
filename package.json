{
  "name": "lan-party",
  "private": true,
  "version": "0.1.0",
  "description": "A local-network multiplayer lobby. Everyone joins one hotspot, opens a URL, and plays. No internet, no installs.",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1"
  }
}
