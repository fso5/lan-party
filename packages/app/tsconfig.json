{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // Resolve @tanks/core to its TypeScript source rather than its build
      // output. Two reasons:
      //
      //  1. core's package.json points main at dist/index.js, but its tsconfig
      //     uses rootDir "." while including both src/ and test/, so tsc
      //     actually emits dist/src/index.js. The declared entry point does not
      //     exist. Reported as a cross-lane issue; packages/core is Session A's.
      //  2. Even once that is fixed, pointing at source means their edits show
      //     up in my Metro reload without a build step in between.
      "@tanks/core": ["../core/src/index.ts"],
      "@tanks/core/*": ["../core/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "../core/src/**/*.ts"],
  "exclude": ["node_modules"]
}
