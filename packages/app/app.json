{
  "expo": {
    "name": "Tanks!",
    "slug": "tanks",
    "version": "0.1.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1117",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fso5.tanks",
      "requireFullScreen": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Tanks! uses Bluetooth to find and play with people nearby, with no internet connection.",
        "NSLocalNetworkUsageDescription": "Tanks! uses the local network to play with people on the same Wi-Fi or hotspot, with no internet connection.",
        "UIRequiresPersistentWiFi": false
      }
    },
    "android": {
      "package": "com.fso5.tanks",
      "adaptiveIcon": {
        "backgroundColor": "#0d1117",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-dev-client"]
  }
}
